# .env.example - copy to .env and fill in. Never commit .env.
APP_NAME=RIC Backend
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true

# App connection (async driver). db_bootstrap creates this user and database.
# URL-encode special characters in passwords (@ -> %40, # -> %23).
DATABASE_URL=postgresql+asyncpg://ric_app:change_me@localhost:5432/ric_poc
DB_ECHO=false

# Superuser connection. Used only by scripts/db_bootstrap.py.
ADMIN_DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/postgres

# Logging: LOG_LEVEL is DEBUG, INFO, WARNING or ERROR.
# LOG_FORMAT is console (readable, local) or json (one JSON object per line, Azure).
LOG_LEVEL=INFO
LOG_FORMAT=console

# Comma-separated browser origins allowed to call the API (admin portal, Expo web).
# Leave empty to allow none. "*" is rejected.
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# Interactive API docs at /docs. Set to false in production.
DOCS_ENABLED=true

# One api_request_log row per API request (health, docs and OPTIONS are skipped).
REQUEST_LOG_ENABLED=true

# --- LLM ------------------------------------------------------------------------------
# Provider: fake (no network, no key), nvidia (NVIDIA NIM), groq, foundry (Azure AI Foundry).
# Switching provider is only these lines; check with: uv run python -m scripts.llm_check
LLM_PROVIDER=nvidia
# Empty = provider default: nvidia -> nvidia/nemotron-3.5-lightning-30b-a3b,
# groq -> openai/gpt-oss-20b. Foundry: your deployment name (required).
LLM_MODEL=
LLM_API_KEY=nvapi-your-key
# Empty = provider default. Foundry (required): https://<resource>.openai.azure.com/openai/v1/
LLM_BASE_URL=
# auto (recommended): nvidia -> json_schema, groq/foundry -> json_object.
# Other values: nvext, json_schema, json_object, none.
LLM_STRUCTURED_OUTPUT=auto
# Free endpoints can be slow: seconds to wait before a call counts as unavailable.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=2048
# Optional extra request fields as JSON, merged last. Example:
# LLM_EXTRA_BODY={"top_p": 0.9}
LLM_EXTRA_BODY={}

# Optional second provider, used only when the first is unavailable (timeout,
# network error, rate limit, 5xx). none | fake | nvidia | groq | foundry.
# Same provider: the API key above is reused. NVIDIA's free rate limit is shared
# by all models on one key, so a different provider (e.g. groq) helps more with 429s.
LLM_FALLBACK_PROVIDER=nvidia
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=

# true = run tests/test_llm_live.py (one real call). Keep false for normal test runs.
LLM_LIVE_TEST=false
